# Copy to .env locally. Never commit real credentials.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/lovemet
OTP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
# PostgreSQL-backed auth requires a reachable database and schema migration:
# psql "$DATABASE_URL" -f db/schema.sql
# Twilio Programmable Messaging (real SMS; no development OTP is exposed):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set DATABASE_SSL=true when your managed PostgreSQL provider requires TLS.
DATABASE_SSL=false

# Optional TURN relay configuration (Coturn REST API / shared-secret authentication)
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SHARED_SECRET=replace-with-a-random-secret-at-least-32-characters
