{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lovemet-cloudflare-preview",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "27dbf115fbff4fc79df45e4af2f82bda"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_ROOMS",
        "class_name": "CallRooms"
      },
      {
        "name": "USER_EVENTS",
        "class_name": "UserEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CallRooms"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "UserEvents"
      ]
    }
  ]
}
