{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lovemet-cloudflare-preview",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/healthz",
      "/chat",
      "/signal"
    ]
  }
}
